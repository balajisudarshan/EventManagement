# Application Port
PORT=5000

# Neon PostgreSQL Database Connection URL
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# JWT Authentication Secret
JWT_SECRET="your-jwt-secret-min-32-chars-long"

# Frontend Client Origin URL (CORS)
CLIENT_URL="http://localhost:3000"

# Cloudinary Storage Credentials (optional - falls back gracefully if not configured)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

